# Populated by nginx image entrypoint: ${APP_HOSTNAME} from container env.
# Certificates: shared volume certbot-central-certs → /etc/letsencrypt/live/<domain>/

upstream poc_nextphone_app {
    server app:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name ${APP_HOSTNAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_HOSTNAME};

    # Set via env (see docker-compose.yml). Defaults: certbot-central layout under /etc/letsencrypt/live/<APP_HOSTNAME>/
    # Wildcard *.revendo.com: use docker-compose.wildcard-tls.yml and paths under /etc/nginx/tls/
    ssl_certificate ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    client_max_body_size 25m;

    location / {
        proxy_pass http://poc_nextphone_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
