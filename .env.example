# Copy to .env and fill in. Never commit .env with secrets.

# SQLite (local). Docker Compose defaults to file:/data/prod.sqlite via compose env.
DATABASE_URL="file:./dev.sqlite"

# From Shopify Partner Dashboard → App → API credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL of this Remix app (used for OAuth). No trailing slash.
# Local dev: set by `shopify app dev` tunnel when using CLI.
SHOPIFY_APP_URL=

# Comma-separated OAuth scopes — must match shopify.app.toml [access_scopes] after deploy.
# Example for the default Remix template (product demo):
SCOPES=write_products

# Optional: custom shop domain for multi-region setups
# SHOP_CUSTOM_DOMAIN=
