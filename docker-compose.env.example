# Copy to .env next to docker-compose.yml on the server (never commit real secrets).
# Required for `docker compose up`.

# Public hostname — must match DNS, TLS cert (e.g. wildcard *.revendo.com), and nginx server_name.
APP_HOSTNAME=mobile-onboarding-stage.revendo.com

# Paths inside the nginx container (defaults match certbot-central: /etc/letsencrypt/live/<APP_HOSTNAME>/).
# For commercial wildcard + docker-compose.wildcard-tls.yml, these are overridden — see docs/DOCKER.md.
# SSL_CERTIFICATE=/etc/letsencrypt/live/mobile-onboarding-stage.revendo.com/fullchain.pem
# SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/mobile-onboarding-stage.revendo.com/privkey.pem

# Must match Partner Dashboard + browser (scheme + host + port, no trailing slash).
# Staging uses WAN :8889 → set HTTPS_PORT below and include :8889 here.
SHOPIFY_APP_URL=https://mobile-onboarding-stage.revendo.com:8889

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products

# Phone number pool Cloud Function (server-to-server, API key auth).
NUMBERS_FUNCTION_URL=https://europe-west6-shopify-458710.cloudfunctions.net/numbers
NUMBERS_API_KEY=

# Publish nginx HTTPS on host 8889 (matches port forward to this VM).
HTTPS_PORT=8889
HTTP_PORT=80
