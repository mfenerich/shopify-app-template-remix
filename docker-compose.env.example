# Copy to .env next to docker-compose.yml on the server (never commit real secrets).
# Required for `docker compose up`.

# Public hostname — must match DNS, TLS cert (add-domain.sh), and nginx server_name.
APP_HOSTNAME=poc-nextphone-staging.revendo.com

# Must be https:// + same host as APP_HOSTNAME, no trailing slash (Shopify OAuth).
SHOPIFY_APP_URL=https://poc-nextphone-staging.revendo.com

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products

# Optional: map host ports if 80/443 are already in use
# HTTP_PORT=8080
# HTTPS_PORT=8443
